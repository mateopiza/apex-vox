{
  "manifest_version": 3,
  "name": "Apex Box — Grabador de Reuniones",
  "version": "3.1.0",
  "description": "Graba reuniones presenciales o virtuales (Zoom, Meet, Teams) desde una pestaña fija y recibe un enlace con notas, resumen y acta.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Apex Box · Abrir grabador",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabCapture"
  ],
  "host_permissions": [
    "https://apex-vox.ialabs.app/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}
