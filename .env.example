# ==============================================================================
# Apex Vox — environment configuration
# ==============================================================================
# Copy to `.env` and fill in your own values:   cp .env.example .env
# NEVER commit `.env`. Every value below is a placeholder.
# Variables already exported in your shell override this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core / server
# ------------------------------------------------------------------------------
ENVIRONMENT=development              # development | production
LOG_LEVEL=info                       # debug | info | warning | error
HOST_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=*                      # e.g. apexvox.example.com (never "*" in production)
CORS_ORIGINS=*                       # comma-separated origins
ENABLE_DOCS=                         # empty = /docs only in development
ENABLE_HSTS=false                    # true only when served over HTTPS
# Server secret for HMACs (IP hashes, OAuth tokens, one-time codes):
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
# Operational endpoints and detailed /api/health require header X-Admin-Key
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# Transcription (Groq) and diarization (Deepgram, optional)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key
DEFAULT_MODEL=whisper-large-v3
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
DEFAULT_DIARIZATION_ENGINE=hybrid_deepgram_groq
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# Audio processing
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=100
CHUNK_DURATION_MINUTES=10
CHUNK_MAX_BYTES=25000000             # Groq hard limit is 25 MB
SILENCE_THRESHOLD_DB=-30
SILENCE_MIN_DURATION_SEC=0.5
APP_UID=1000                         # container user (match your host `id -u`)
APP_GID=1000

# ------------------------------------------------------------------------------
# Object storage (any S3-compatible provider)
# ------------------------------------------------------------------------------
MEGA_S4_ENDPOINT_URL=https://s3.example-region.example.com
MEGA_S4_REGION=                      # derived from the endpoint host when possible
MEGA_S4_BUCKET_NAME=apex-vox-storage
MEGA_S4_ACCESS_KEY_ID=
MEGA_S4_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Supabase (Google / GitHub sign-in and optional table sync)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server-side only, never in the browser
SUPABASE_DATABASE_PASSWORD=

# ------------------------------------------------------------------------------
# Plans and payments (Bold, USD, manual monthly renewal)
# ------------------------------------------------------------------------------
BOLD_API_KEY=
BOLD_SECRET_KEY=
BOLD_WEBHOOK_SECRET=
FREE_DAILY_HOURS=2.0
FREE_RETENTION_HOURS=24
PRO_PRICE_USD=10
PRO_PERIOD_DAYS=30
PROMO_DISCOUNT_PCT=20
PROMO_WINDOW_HOURS=24
PROMO_IP_COOLDOWN_DAYS=90
RENEWAL_REMINDER_DAYS=3

# Accounts and limits
# GUEST_MAX_AUDIOS_PER_DAY=3
# GUEST_MAX_AUDIO_MINUTES=30
# GUEST_RESULT_TTL_MINUTES=60
# MAX_IPS_PER_MONTH=3
# SESSION_TTL_DAYS=30

# ------------------------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=                      # sending-only key is enough
EMAIL_FROM=Apex Vox <hello@example.com>
EMAIL_REPLY_TO=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_NEWSLETTER_TOPIC_ID=
# Inbound calendar invitations (optional)
INVITES_ADDRESS=                     # e.g. agenda@invites.example.com (empty = hidden)
RESEND_INBOUND_API_KEY=              # key allowed to read received emails
RESEND_INBOUND_WEBHOOK_SECRET=       # whsec_… from the Resend webhook

# ------------------------------------------------------------------------------
# Meeting bot (Recall.ai, optional, Apex Pro)
# ------------------------------------------------------------------------------
RECALL_API_KEY=
RECALL_REGION=us-west-2
RECALL_WEBHOOK_SECRET=               # whsec_… from the Recall webhook endpoint
BOT_NAME=Apex Vox · notas

# ------------------------------------------------------------------------------
# Recorded calls with a masked number (Twilio, optional, Apex Pro)
# Webhooks use PUBLIC_BASE_URL: it must be the public https:// origin.
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=                  # AC…
TWILIO_AUTH_TOKEN=                   # also validates X-Twilio-Signature
TWILIO_API_KEY_SID=                  # optional SK… for the REST API
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=           # VA… (SMS code to verify the user's phone)
TWILIO_CALLER_ID=                    # e.g. +15005550006 — the number contacts see
CALL_ALLOWED_PREFIXES=+57,+1,+52
CALL_MAX_MINUTES=90
CALLS_PER_DAY=30
CALL_RECORDING_NOTICE=true           # both parties hear the recording notice
TWILIO_DELETE_RECORDINGS=true
APP_TIMEZONE=America/Bogota          # dates in the MCP tools

# ------------------------------------------------------------------------------
# Telegram bot (optional)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=                    # chat that receives the daily usage report

# ------------------------------------------------------------------------------
# Legal / contact (shown in /legal/* and /.well-known/security.txt)
# ------------------------------------------------------------------------------
LEGAL_ENTITY_NAME=Your Company
LEGAL_ENTITY_ID=
LEGAL_ADDRESS=
LEGAL_CITY=
LEGAL_PHONE=
CONTACT_EMAIL=hello@example.com
SECURITY_EMAIL=security@example.com
