# ==============================================================================
# Audio Transcription & Speaker Identification Application Environment Config
# ==============================================================================
# Copy this file to '.env' and populate your sensitive credentials:
#   cp .env.example .env
#
# Precedence note:
# Any environment variables set in your host shell (e.g. 'export GROQ_API_KEY=...')
# will override the values specified in this file when running Docker Compose.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq Cloud API Credentials (Required for Transcription & Diarization)
# ------------------------------------------------------------------------------
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=***REMOVED***

# Default Groq Whisper model for audio speech-to-text
# Options:
#   - whisper-large-v3        (Highest accuracy, multilingual, recommended)
#   - whisper-large-v3-turbo  (Faster inference speed, lower latency)
DEFAULT_MODEL=whisper-large-v3

# Default Groq LLM model for conversational speaker diarization & turn attribution
# Options:
#   - llama-3.3-70b-versatile (Recommended: best contextual reasoning & diarization)
#   - llama-3.1-8b-instant    (Low-latency fallback for high-throughput)
DEFAULT_LLM_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 2. Web Server & Network Configuration
# ------------------------------------------------------------------------------
# Host port mapping for FastAPI web server (defaults to 8000:8000)
HOST_PORT=8000

# Application environment mode (development | production)
# production: hides /docs, returns generic 500 errors, intended for deployment.
ENVIRONMENT=production

# Comma-separated origins allowed by CORS ("*" = any origin, no credentials)
CORS_ORIGINS=*

# Comma-separated hostnames accepted in the Host header ("*" disables the check)
# e.g. ALLOWED_HOSTS=apexvox.example.com,localhost
ALLOWED_HOSTS=apex-vox.ialabs.app

# Force-enable or disable Swagger (/docs) and ReDoc; empty = on in development only
ENABLE_DOCS=

# Send Strict-Transport-Security; enable only when served over HTTPS
ENABLE_HSTS=false

# Public URL of the app, used for Google/GitHub sign-in and Bold callbacks
PUBLIC_BASE_URL=https://apex-vox.ialabs.app

# Accounts & plans (defaults: strict in production, relaxed in development)
# REQUIRE_LOGIN_TO_TRANSCRIBE=true   # 2h/day free starts at sign-up
# ALLOW_PLAN_SIMULATOR=false         # playground free/pro switch, never in production
# SESSION_TTL_DAYS=30
# PRO_PERIOD_DAYS=30                 # days of Apex Pro per approved Bold payment

# Logging level (debug | info | warning | error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. Audio Slicing, Chunking & Silence Detection Engine
# ------------------------------------------------------------------------------
# Maximum file upload size allowed per track in Megabytes
MAX_FILE_SIZE_MB=100

# Target chunk duration in minutes for audio splitting when exceeding 25MB
CHUNK_DURATION_MINUTES=10

# Maximum audio payload size in bytes per Groq Whisper API request
# Groq hard limit is 25 MB (26,214,400 bytes).
# We use 25,000,000 bytes (~23.84 MB) to provide a safe buffer for multipart headers.
CHUNK_MAX_BYTES=25000000

# Silence detection noise threshold in decibels for FFmpeg (silencedetect filter)
SILENCE_THRESHOLD_DB=-30

# Minimum silence duration in seconds to trigger an audio split boundary
SILENCE_MIN_DURATION_SEC=0.5

# ------------------------------------------------------------------------------
# 4. Storage & Linux User Permission Configuration (UID / GID)
# ------------------------------------------------------------------------------
# User and Group ID under which container processes run.
# Match your host user ID to prevent root-owned files in bind mounts:
#   Linux / WSL: $(id -u) and $(id -g), typically 1000
#   macOS: usually 501
APP_UID=1000
APP_GID=1000

# Persistent storage directories inside container (defaults match app/config.py)
# UPLOAD_DIR=/app/uploads
# OUTPUT_DIR=/app/outputs

# ------------------------------------------------------------------------------
# 5. MEGA S4 Object Storage (S3-Compatible Cloud Storage)
# ------------------------------------------------------------------------------
# Free Plan: 24-hour retention | Paid Plan (Apex Pro): Unlimited retention
MEGA_S4_ENDPOINT_URL=s3.eu-amsterdam-1.megas4.com
MEGA_S4_REGION=eu-luxembourg-1
MEGA_S4_BUCKET_NAME=apex-vox-storage
MEGA_S4_ACCESS_KEY_ID=***REMOVED***
MEGA_S4_SECRET_ACCESS_KEY=***REMOVED***

# ------------------------------------------------------------------------------
# 6. Supabase Cloud Backend (PostgreSQL + Auth + Quotas)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://phavrymydailzprdevhf.supabase.co
SUPABASE_ANON_KEY=***REMOVED***
SUPABASE_SERVICE_ROLE_KEY=***REMOVED***
SUPABASE_DATABASE_PASSWORD=***REMOVED***

# ------------------------------------------------------------------------------
# 7. Bold API Payments & Subscriptions ($30.000 COP / $10 USD · 3-Day Free Trial)
# ------------------------------------------------------------------------------
BOLD_API_KEY=***REMOVED***
BOLD_SECRET_KEY=***REMOVED***
BOLD_WEBHOOK_SECRET=
FREE_DAILY_HOURS=2.0
FREE_RETENTION_HOURS=24
PRO_PRICE_COP=30000
PRO_PRICE_USD=10
PRO_TRIAL_DAYS=3

